{
  "name": "kimi-code-agent-macos",
  "displayName": "Kimi Code Agent for macOS",
  "description": "Native macOS local-first Kimi coding agent workbench.",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:cli": "node scripts/bundle-cli.mjs",
    "build:full": "npm run build && npm run bundle:cli",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:check": "cd macos && swift run KimiAgentCoreChecks",
    "native:build": "swift build --package-path macos --product KimiCodeAgent",
    "native:package": "npm run build && node scripts/package-kimi-code-agent-native.mjs",
    "opencode:install": "npm run build && node scripts/opencode-fusion.mjs install",
    "opencode:prepare": "npm run build && node scripts/opencode-fusion.mjs prepare",
    "opencode:package": "npm run native:package",
    "verify": "npm run check && npm test && npm run native:check"
  },
  "dependencies": {
    "@moonshot-ai/kimi-agent-sdk": "0.1.8",
    "@moonshot-ai/kimi-code": "0.33.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
